{
  "name": "llm-thunderbird",
  "version": "2.4.0",
  "description": "A Thunderbird extension enabling LLM support while writing E-Mails",
  "main": "background.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.3.0"
  },
  "scripts": {
    "start": "webpack --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && webpack --mode production",
    "build-trace": "tsc --noEmit && webpack --mode production --env trace",
    "zip": "run-script-os",
    "zip:darwin:linux": "cd build && zip -r ../llm-thunderbird.xpi ./*",
    "zip:win32": "cd build && 7z a -tzip ../llm-thunderbird.xpi ./*",
    "zip-trace": "run-script-os",
    "zip-trace:darwin:linux": "cd build && zip -r ../llm-thunderbird-trace.xpi ./*",
    "zip-trace:win32": "cd build && 7z a -tzip ../llm-thunderbird-trace.xpi ./*",
    "clean-xpi": "node -e \"const fs=require('node:fs');for (const f of ['llm-thunderbird.xpi','llm-thunderbird-trace.xpi','llm-thunderbird-dev.xpi']) fs.rmSync(f,{force:true})\"",
    "ship": "pnpm run clean-xpi && pnpm run build-trace && pnpm run zip-trace && pnpm run build && pnpm run zip",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "lint": "biome ci ./",
    "lint-fix": "biome check --write ./",
    "lint-fix-unsafe": "biome check --unsafe --write ./"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TNG/thunderbird-llm-composer"
  },
  "keywords": [
    "LLM",
    "Thunderbird",
    "huggingface",
    "llm-ls"
  ],
  "author": "TNG Technology Consulting GmbH",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/jsdom": "^30.0.0",
    "@types/thunderbird-webext-browser": "^127.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "jsdom": "^30.0.1",
    "run-script-os": "^1.1.6",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-fetch-mock": "^0.4.5",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
